<?xml version="1.0" encoding="utf-8"?>

<xml>
	<set name="NAME" value="tuna" />

	<include name="${HXCPP}/build-tool/BuildCommon.xml" />

	<set name="HXCPP_CPP11" value="1" />
	<set name="DEBUGEXTRA" value="-debug" if="fulldebug" />

	<files id="tuna">
		<compilerflag value="-Iinclude" />
		<compilerflag value="-Ilibs/glad/include/" />
		<compilerflag value="-fPIC" if="linux" />

		<file name="src/tuna/NativePlatform.cpp" />
		<file name="src/tuna/NativeWindow.cpp" />
		<file name="src/tuna/opengl/OpenGL.cpp" />
		<file name="src/tuna/openal/OpenAL.cpp" />
		<file name="src/tuna/openal/OpenALC.cpp" />
		<file name="src/tuna/cffi/CFFI.cpp" />
		<file name="src/gl.c" />
	</files>

	<target id="NDLL" output="${NAME}" tool="linker" toolid="${STD_MODULE_LINK}">
		<outdir name="../ndll/${BINDIR}" />
		<ext value=".ndll" />

		<files id="tuna" />

		<section if="linux">
			<lib name="-lpthread" />
			<lib name="-lrt" />
			<lib name="-lgc" />
			<lib name="-lm" />
			<lib name="-lopenal" />
			<lib name="-lGL" />
			<lib name="-lX11" />
			<lib name="-lXext" />
			<lib name="-lXrandr" />
			<lib name="-lXi" />
			<lib name="-lXxf86vm" />
			<lib name="-lXcursor" />
			<lib name="-lXinerama" />
			<lib name="-ldl" />
			<lib name="-lSDL3" />
			<lib name="-lopenal"/>
		</section>
	</target>

	<target id="default">
		<target id="NDLL"/>
	</target>

</xml>